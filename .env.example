# Copy to .env and fill in. NEVER commit .env.
#
# On Windows with a default PostgreSQL 16 install the user is usually
# "postgres" and you chose the password during setup.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/money
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/money_test

# The app REFUSES TO BOOT while this is the placeholder value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

SIGNUP_GRANT=100000.00
CURRENCY=BDT
ENVIRONMENT=development
